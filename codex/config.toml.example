# HFA Codex baseline
# Verified against current Codex configuration behavior and OpenAI model guidance on 2026-09-05.
# Copy/merge into ~/.codex/config.toml after reviewing any existing local settings.

# Astra is the HFA commander model for the hardest end-to-end technical work.
model = "gpt-6-astra"
model_reasoning_effort = "high"
model_reasoning_summary = "auto"
model_verbosity = "medium"

# Reversible-by-default execution posture.
approval_policy = "on-request"
sandbox_mode = "workspace-write"

# Keep project instruction files bounded and predictable.
project_doc_max_bytes = 32768

[features]
# Persist goals across long-running work.
goals = true
# Preserve durable project context across long sessions.
memories = true
# Multi-agent collaboration is part of the HFA commander/worker architecture.
multi_agent = true

[features.context_management]
# Preserve notes + searchable prior context rather than relying only on repeated compaction.
experimental_mode = true

[agents]
# Start deliberately below swarm scale. Increase only when a task truly has more independent workstreams.
max_concurrent_threads_per_session = 4
# Spawn ordinary workers on the price/performance model unless the root explicitly selects another model.
default_subagent_model = "gpt-5.6-terra"
default_subagent_reasoning_effort = "medium"

# Do not hard-code MCP credentials, API keys, or secrets in this file.
# Preserve existing machine-specific MCP servers, plugins, providers, trusted projects,
# authentication settings, hooks, and desktop configuration when merging locally.
